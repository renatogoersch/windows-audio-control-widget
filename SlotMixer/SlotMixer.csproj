<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>SlotMixer</RootNamespace>
    <Version>1.7.1</Version>
    <Product>SlotMixer</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SlotMixer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tells the updater which zip to fetch: the one with the .NET runtime inside or the small one. -->
    <AssemblyMetadata Include="SelfContained" Value="$(SelfContained)" />
  </ItemGroup>

</Project>
